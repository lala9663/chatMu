<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      알림 접근 권한(설정 화면에서 유저가 직접 허용)을 받는 서비스.
      허용되면 시스템이 자동으로 바인딩·유지하므로 별도 foreground service 불필요.
      android:name은 FQN — 앱 매니페스트에 머지될 때 앱 패키지 기준으로 해석되지 않도록.
    -->
    <service
      android:name="com.chatmu.mediadetector.ChatMuNotificationListenerService"
      android:label="chatMu 재생 감지"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
